# رابط حصة Google Meet
MEET_URL=https://meet.google.com/xxx-yyyy-zzz

# اسم الطالب للدخول في الحصة وكلمة مفتاحية لرصد المناداة
STUDENT_NAME=أحمد علي

# كلمات مفتاحية إضافية لرصدها في الشات (مفصولة بفاصلة)
TRIGGER_KEYWORDS=أحمد,يا أحمد,احمد,أستاذ

# رسالة الرد التلقائي عند المناداة
AUTO_REPLY_MESSAGE=عذراً أستاذ، المايك معطل لدي اليوم وأنا حاضر ومتابع معكم في الحصة.

# فترة التهدئة بالثواني بين الردود التلقائية لتفادي السبام (300 ثانية = 5 دقائق)
AUTO_REPLY_COOLDOWN_SECONDS=300

# أقصى مدة للبقاء في الحصة بالدقائق (مثلاً 90 دقيقة ثم يغادر البوت تلقائياً)
MAX_DURATION_MINUTES=90

# تشغيل المتصفح في وضع الخفاء (Headless) - ضع 1 للتشغيل الصامت أو 0 للرؤية المحلية
HEADLESS=1

# لغة المتصفح المفضلة (ar أو en)
BROWSER_LOCALE=ar
